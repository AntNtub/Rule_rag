# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Azure OpenAI (deployment names are configured in Azure AI Foundry)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-GPT4-DEPLOYMENT
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT
# Leave blank when using Azure Managed Identity / `az login`.
AZURE_OPENAI_API_KEY=

# Azure Cosmos DB for NoSQL
AZURE_COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
AZURE_COSMOS_DATABASE=campus-policy
AZURE_COSMOS_CONTAINER=regulation-chunks
# Leave blank when using Azure Managed Identity / `az login`.
AZURE_COSMOS_KEY=

# The dimension MUST match the Azure OpenAI embedding deployment.
EMBEDDING_DIMENSIONS=1536
VECTOR_INDEX_TYPE=quantizedFlat
RETRIEVAL_TOP_K=6
# Empty disables the distance cutoff. Cosmos cosine distance: lower is closer.
MAX_VECTOR_DISTANCE=
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
GENERATION_TEMPERATURE=0.0

